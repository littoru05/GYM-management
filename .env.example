# ==============================================================================
# GYM MANAGEMENT SYSTEM - ROOT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ports Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8080
DB_PORT=3307

# ------------------------------------------------------------------------------
# 2. Database Configuration (MySQL 8.4)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_NAME=gym_management
DB_USERNAME=root
DB_PASSWORD=123456

# ------------------------------------------------------------------------------
# 3. Backend & Security Configuration (Spring Boot 3)
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
# Comma-separated allowed frontend origins or patterns
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:80,http://127.0.0.1:*
# 256-bit Hex secret key for HS256 HMAC-SHA JWT signing
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 4. Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------
# For local Vite dev server (npm run dev): use http://localhost:8080/api
# For Docker / production Nginx reverse proxy: use /api
VITE_API_BASE_URL=http://localhost:8080/api
# Toggle mock mode (false = use real Spring Boot API, true = use in-memory mock)
VITE_USE_MOCK=false
