# ==============================================================================
# BACKEND (SPRING BOOT) ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server & Profile
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3307
DB_NAME=gym_management
DB_USERNAME=root
DB_PASSWORD=123456

# Database Connection Pool (HikariCP - Tuned for Cloud/RDS)
DB_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
DB_KEEPALIVE_TIME_MS=30000

# CORS Configuration (Comma-separated allowed origins or wildcards)
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:80,http://127.0.0.1:*
CORS_ALLOWED_ORIGINS=https://*.vercel.app,https://*.elb.amazonaws.com,http://*.elb.amazonaws.com,https://*.duckdns.org,http://*.duckdns.org,http://localhost:5173,http://localhost:3000,http://localhost:80,http://127.0.0.1:*

# JWT Security Configuration (256-bit Hex secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Logging Configuration
LOG_FILE=logs/gym-backend.log
