        {
          "name": "TC240 - Chuỗi nghiệp vụ 3 (DoD): Đánh dấu 1 liên hệ đã đọc -> unreadCount giảm 1 (200 OK)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Tạo 1 lead rồi đánh dấu đọc trong pre-request",
                  "var baseUrl = pm.environment.get('base_url') || pm.collectionVariables.get('base_url') || 'http://localhost:8080';",
                  "var staffTok = pm.environment.get('staff_token') || pm.collectionVariables.get('staff_token') || '';",
                  "pm.sendRequest({",
                  "    url: baseUrl + '/api/leads',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: {",
                  "        mode: 'raw',",
                  "        raw: JSON.stringify({",
                  "            name: 'Lead Giam Tru TC240',",
                  "            phone: '0977' + Math.floor(100000 + Math.random() * 900000),",
                  "            email: 'giamtru_' + Date.now() + '@gmail.com',",
                  "            message: 'Test giảm trừ'",
                  "        })",
                  "    }",
                  "}, function (err, res) {",
                  "    if (res && res.json && res.json().id) {",
                  "        var newId = res.json().id;",
                  "        pm.sendRequest({",
                  "            url: baseUrl + '/api/notifications/' + newId + '/read',",
                  "            method: 'PATCH',",
                  "            header: { 'Authorization': 'Bearer ' + staffTok }",
                  "        }, function (e, r) {});",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Trạng thái HTTP 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var res = pm.response.json();",
                  "pm.test('unreadCount là số nguyên hợp lệ', function () {",
                  "    pm.expect(res.unreadCount).to.be.at.least(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
