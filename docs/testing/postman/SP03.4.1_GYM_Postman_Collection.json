                  "pm.test('Liên hệ mới có isRead = false và status = NEW', function () {",
                  "    pm.expect(res.isRead).to.eql(false);",
                  "    pm.expect(res.status).to.eql('NEW');",
                  "    pm.expect(Number(res.id)).to.be.above(0);",
