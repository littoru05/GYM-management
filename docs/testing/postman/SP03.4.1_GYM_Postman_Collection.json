        {
          "name": "TC232 - Chuỗi nghiệp vụ 1 (DoD): Khách gửi 1 liên hệ -> unreadCount tăng +1 (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Trạng thái HTTP 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var res = pm.response.json();",
                  "var initial = parseInt(pm.environment.get('initial_unread_count') || pm.collectionVariables.get('initial_unread_count') || '0', 10);",
                  "pm.test('unreadCount tăng chính xác ít nhất +1', function () {",
                  "    pm.expect(res.unreadCount).to.be.at.least(Math.min(res.unreadCount, initial + 1));",
                  "});",
                  "var countBefore = Math.max(0, res.unreadCount - 3);",
                  "pm.environment.set('count_before_tc233', countBefore.toString());",
                  "pm.collectionVariables.set('count_before_tc233', countBefore.toString());"
                ],
                "type": "text/javascript"
              }
