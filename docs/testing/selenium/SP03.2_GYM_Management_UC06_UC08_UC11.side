      "id": "tc11-uc08-nav-id",
      "name": "TC11_UI_11_UC08_DieuHuong_TrangCheckIn",
      "commands": [
        {
          "id": "c11-1",
          "comment": "Mở trang đăng nhập",
          "command": "open",
          "target": "/login",
          "targets": [],
          "value": ""
        },
        {
          "id": "c11-2",
          "comment": "Đặt kích thước màn hình",
          "command": "setWindowSize",
          "target": "1920x1080",
          "targets": [],
          "value": ""
        },
        {
          "id": "c11-3",
          "comment": "Nhập email tài khoản Staff",
          "command": "type",
          "target": "xpath=//input[@type='email']",
          "targets": [],
          "value": "staff@gym.local"
        },
        {
          "id": "c11-4",
          "comment": "Nhập mật khẩu Staff",
          "command": "type",
          "target": "xpath=//input[@type='password']",
          "targets": [],
          "value": "123456"
        },
        {
          "id": "c11-5",
          "comment": "Nhấn nút Đăng nhập",
          "command": "click",
          "target": "xpath=//button[@type='submit']",
          "targets": [],
          "value": ""
        },
        {
          "id": "c11-6",
          "comment": "Chờ chuyển hướng vào quầy",
          "command": "waitForElementPresent",
          "target": "xpath=//a[@href='/staff/check-in']",
          "targets": [],
          "value": "5000"
        },
        {
          "id": "c11-7",
          "comment": "Bấm vào menu Điểm danh",
          "command": "click",
          "target": "xpath=//a[@href='/staff/check-in']",
          "targets": [],
          "value": ""
        },
        {
          "id": "c11-8",
          "comment": "Kiểm tra tiêu đề Điểm danh Check-in",
          "command": "assertText",
          "target": "xpath=//h1",
          "targets": [],
          "value": "Điểm danh Check-in"
        },
        {
          "id": "c11-9",
          "comment": "Kiểm tra mô tả trang điểm danh",
          "command": "assertText",
          "target": "xpath=//p[contains(text(),'Nhập số điện thoại')]",
          "targets": [],
          "value": "Nhập số điện thoại hoặc mã hội viên để điểm danh tại quầy."
        },
        {
          "id": "c11-10",
          "comment": "Kiểm tra ô nhập lớn tự động focus",
          "command": "assertElementPresent",
          "target": "xpath=//input[contains(@class,'tracking-wide')]",
          "targets": [],
          "value": ""
        },
        {
          "id": "c11-11",
          "comment": "Kiểm tra thẻ thống kê Đã check-in hôm nay",
          "command": "assertText",
          "target": "xpath=//p[contains(text(),'Đã check-in hôm nay')]",
          "targets": [],
          "value": "ĐÃ CHECK-IN HÔM NAY"
        },
        {
          "id": "c11-12",
          "comment": "Kiểm tra tiêu đề bảng Lịch sử check-in hôm nay",
          "command": "assertText",
          "target": "xpath=//h2[contains(text(),'Lịch sử check-in hôm nay')]",
          "targets": [],
          "value": "Lịch sử check-in hôm nay"
        }
      ]
