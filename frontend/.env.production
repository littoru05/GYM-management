# ==============================================================================
# FRONTEND PRODUCTION ENVIRONMENT CONFIGURATION (AWS ALB ROUTING)
# ==============================================================================
# Trỏ trực tiếp tới đường dẫn relative /api trên máy chủ AWS ALB.
# Khi truy cập qua DNS của AWS Application Load Balancer (ALB) hoặc DuckDNS:
# - Tất cả API request sẽ tự động gửi tới http://<ALB_DNS>/api/*
# - AWS ALB Listener Rule 10 sẽ forward trực tiếp tới Backend Target Group (Spring Boot port 8080)
# - Không bị lỗi CORS, không bị hardcode IP/localhost, hoàn toàn thích ứng với dynamic DNS của AWS ALB
VITE_API_BASE_URL=/api

# Chế độ Mock: Tắt mock để kết nối với cơ sở dữ liệu thật qua backend
VITE_USE_MOCK=false
