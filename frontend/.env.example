# ==============================================================================
# FRONTEND (VITE REACT SPA) ENVIRONMENT CONFIGURATION
# ==============================================================================

# API Base URL:
# - When running local Vite dev server: http://localhost:8080/api
# - When running in Docker container with Nginx reverse proxy: /api
VITE_API_BASE_URL=http://localhost:8080/api

# Mock Mode:
# - false: Connect to real Spring Boot backend API
# - true: Fallback to local in-memory mock data
VITE_USE_MOCK=false
